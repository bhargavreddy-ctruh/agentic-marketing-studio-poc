# Copy to .env and fill in real values. The app boots cleanly with ALL of these unset —
# each provider raises a clear ProviderUnavailable error only when it's actually called
# without its key, per the "scaffold with placeholders" decision (Memory.md).

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-marketing-studio-poc
LANGSMITH_TRACING=true

# --- Compliance QA gate (compliance_gate.py) — runs automatically after every generation/edit.
# A real extra round of LLM/vision calls per generation; set to false for faster/cheaper local
# iteration. When off, an element's compliance_status is set to "disabled", not "passed".
COMPLIANCE_QA_ENABLED=true

# --- Live "LLM thinking" streaming — real streamed text shown live in Node Mode, per-node, as it
# arrives. A real, extra-complexity code path (reassembles streamed tool calls too, not just
# plain text); set to false to fall back to the original single-shot request/response call.
STREAM_LLM_THINKING_ENABLED=true

# --- Multi-generation (graph.py) — a request for several DISTINCT images/videos (e.g. "2 images,
# one pink one green") runs genuinely INDEPENDENT variants concurrently by default. Set to false
# to force every multi-generation request fully sequential instead — real cost/predictability
# control, especially for video: each independent video variant is its own separate paid
# Replicate render, so "parallel" here means spending on N renders at once, not one at a time.
# A genuinely DEPENDENT sequence always runs sequentially regardless of this flag (a correctness
# requirement, not a preference).
MULTI_GENERATION_PARALLEL_ENABLED=true

# --- Reasoning (self-hosted, Ollama) — TIER_1's new primary, ahead of Groq/OpenRouter below.
# Genuinely $0, no remote rate limit, runs on this machine. Requires Ollama installed
# (`brew install ollama`, then `brew services start ollama`) and the model pulled
# (`ollama pull qwen2.5:3b`) — qwen2.5:3b was chosen specifically because it supports real
# tool-calling (confirmed live); `gemma3:4b` was tried first per the original ask but has no tool
# support at all (`ollama show gemma3:4b` lists only completion/vision), which would break the two
# Tier 1 specialists that genuinely call tools (Reference Curator, Palette Strategist). No API key
# needed — LOCAL_LLM_API_KEY is a placeholder, never checked by Ollama's local server.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL_TIER_1=qwen2.5:3b

# --- Reasoning (OpenRouter) ---
OPENROUTER_API_KEY=
# Verified live against OpenRouter's real /models endpoint + a real completion call on each
# (Memory.md, Phase 1) — cost=0 confirmed on all three. Re-verify before relying on these long
# term; OpenRouter's free catalog changes over time.
MODEL_TIER_1=google/gemma-4-26b-a4b-it:free
MODEL_TIER_2=nex-agi/nex-n2.5-pro:free
MODEL_TIER_3=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Reasoning fallback (Groq) — used only when OpenRouter itself is unavailable (its free tier
# has a hard 50-requests/day cap; router.py falls back here when that's hit). No credit card
# needed for Groq's own free tier signup. Model IDs live-verified against Groq's real /v1/models
# endpoint + a real call (Memory.md, Phase 2) — re-verify before relying on these long term.
GROQ_API_KEY=
GROQ_MODEL_TIER_1=openai/gpt-oss-20b
GROQ_MODEL_TIER_2=openai/gpt-oss-120b
GROQ_MODEL_TIER_3=openai/gpt-oss-120b

# --- Image generation ---
# Pollinations.ai needs no key at all.
HUGGINGFACE_API_TOKEN=

# --- Image editing (Cloudflare Workers AI, FLUX.2 [klein] 4B) — image_editor.py tries this
# BEFORE HuggingFace (real, disclosed reason: HuggingFace's fal-ai sub-provider was returning a
# real 402 Payment Required). Cloudflare's Workers AI gives every account a 10,000-Neuron/day free
# allocation shared across all its models; this model costs ~5.37 Neurons per 512x512 input tile
# and ~26.05 per 512x512 output tile — genuinely free at POC volume. Get ACCOUNT_ID from the
# Cloudflare dashboard URL/sidebar, and API_TOKEN from My Profile > API Tokens (needs Workers AI
# edit permission). Leaving these unset just falls back to HuggingFace, same as before.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Video generation ---
FALAI_API_KEY=
# Added as a second option after real testing found the fal.ai account's balance exhausted
# (Memory.md, Phase 2) — whichever has a working key/balance is the one actually used.
REPLICATE_API_KEY=

# --- Legacy providers (inactive until quota is available again — see providers/image/gemini.py) ---
GEMINI_API_KEY=
GEMINI_IMAGE_ACTIVE=false
GEMINI_VIDEO_ACTIVE=false

# --- Persistence ---
DATABASE_URL=sqlite+aiosqlite:///./poc.db
