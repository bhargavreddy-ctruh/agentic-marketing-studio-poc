[MAIN]
LOG_LEVEL=INFO
ALLOWED_ORIGINS=.ctruh.com,.commverse.studio,*.ctruh.org
IMAGE_TO_3D_URL=https://image-to-3d.ctruh.com/image_to_3d

[AWS]
MODEL=amazon.nova-canvas-v1:0,amazon.titan-image-generator-v2:0
AWS_REGION=us-east-1
API_KEY=
VIDEO_GENERATION_MODEL=amazon.nova-reel-v1:1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
VIDEO_USE_API_KEY=

[GEMINI]
MODEL=gemini-2.5-flash-lite
FALLBACK=gemini-2.5-flash
IMAGE_MODELS=gemini-3.1-flash-image-preview,gemini-3.1-pro-image-preview,gemini-2.5-flash-image
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
VIDEO_GENERATION_MODEL=veo-3.1-generate-preview

[VERTEX]
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
MODEL=gemini-2.5-flash-image,gemini-3.1-flash-image-preview
TRYON_MODEL=virtual-try-on-001
VIDEO_GENERATION_MODEL=veo-3.1-generate-001
#veo-3.1-generate-preview

[CREATIVE]
PROVIDER=VERTEX
FALLBACK=GEMINI,AWS
# Video: try Vertex first, then Gemini
VIDEO_PROVIDER=VERTEX
VIDEO_FALLBACK=GEMINI
VIDEO_CONCURRENCY_LIMIT=25
IMAGE_CONCURRENCY_LIMIT=55


[LLM]
# Shared agent reasoning for Campaign Studio, Assist, Creative Director, Try-on Stylist, Store Composer.
PROVIDER=anthropic
API_KEY=
MODEL=claude-haiku-4-5-20251001
# BASE_URL=
AGENT_MAX_TURNS=12

[CAMPAIGN]
DEFAULT_ASSET_COUNT=3
MAX_ASSET_COUNT=6
MAX_QA_RETRIES=2
ASPECT_RATIO=1:1
AGENT_MAX_TURNS=12

# Optional: studio-backend callback base for Assist tool calls (Node MCP registry).
# Set STUDIO_BACKEND_BASE_URL and STUDIO_INTERNAL_SERVICE_TOKEN in the process env.

