# Compose-level settings (read by docker-compose.yml itself, NOT by the backend app —
# backend/.env is separate and still required for API keys etc.).
# Copy this file to .env in this same directory and fill in real values for your deployment.
# `docker compose` auto-loads a file named exactly ".env" next to docker-compose.yml.

# Where a browser can reach the FRONTEND. Used for backend CORS (FRONTEND_ORIGINS).
# Comma-separate multiple origins if needed (e.g. both a domain and a LAN IP).
PUBLIC_FRONTEND_URL=http://localhost:3000

# Where a browser can reach the BACKEND. Baked into the frontend's JS bundle at BUILD time
# (NEXT_PUBLIC_API_BASE_URL), so changing this requires `docker compose build frontend` again,
# not just a restart.
PUBLIC_BACKEND_URL=http://localhost:8000

# Ollama model to auto-pull on startup. MUST match backend/.env's LOCAL_LLM_MODEL_TIER_1 —
# nothing keeps these two in sync automatically.
OLLAMA_MODEL=llama3.1:8b
