# The ONE env file this repo uses (2026-09-29 — previously split across this file and
# backend/.env.example, which caused a real incident: docker-compose.yml's `env_file` pointed at
# `backend/.env` while its own `${VAR}` substitution always reads THIS file, so a deploy with only
# `backend/.env` configured silently ran against a missing DATABASE_URL). Copy this file to `.env`
# in this same directory (next to docker-compose.yml) and fill in real values — `docker compose`
# auto-loads a file named exactly `.env` here for BOTH its `env_file:` and `${VAR}` substitution,
# so there is nothing else to configure.

# Where a browser can reach the FRONTEND. Used for backend CORS (FRONTEND_ORIGINS).
# Comma-separate multiple origins if needed (e.g. both a domain and a LAN IP).
PUBLIC_FRONTEND_URL=http://localhost:3000

# Where a browser can reach the BACKEND. Baked into the frontend's JS bundle at BUILD time
# (NEXT_PUBLIC_API_BASE_URL), so changing this requires `docker compose build frontend` again,
# not just a restart.
PUBLIC_BACKEND_URL=http://localhost:8000

# --- Persistence (REQUIRED) — Supabase Postgres connection string. Direct connection is
# IPv6-only and commonly unreachable; use the Session Pooler string instead (Project Settings >
# Database > Connection string > "Session pooler" tab), and change its `postgresql://` prefix to
# `postgresql+asyncpg://`. docker-compose.yml refuses to start at all if this is unset — no
# silent SQLite fallback (2026-09-29, after a real incident where that fallback masked a missing
# .env for hours).
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Observability (non-secret, REQUIRED — no fallback in docker-compose.yml) ---
LANGSMITH_PROJECT=agentic-marketing-studio-poc
LANGSMITH_TRACING=true

# --- Reasoning model-tier IDs (Groq — not secrets, just which models to use per tier) ---
GROQ_MODEL_TIER_1=openai/gpt-oss-20b
GROQ_MODEL_TIER_2=openai/gpt-oss-120b
GROQ_MODEL_TIER_3=openai/gpt-oss-120b

# --- Product/Brand crawler (REQUIRED — no fallback in docker-compose.yml) ---
# `ollama` is this compose file's own service name — leave this exactly as-is for a normal
# `docker compose up` deployment; it's only ever different if you're running Ollama somewhere
# else entirely.
OLLAMA_BASE_URL=http://ollama:11434/v1
# Scoped narrowly to the crawler's extraction step (general LLM reasoning stays entirely
# Groq/Replicate; see router.py). Passed to the `ollama` compose service's entrypoint. Only edit
# if you want a different crawler-extraction model.
OLLAMA_MODEL=gemma2:2b

# --- Everything below this line is set ONCE in Supabase's `app_settings` table, not here ---
# key                                  | what it's for
# ------------------------------------ | --------------------------------------------------------
# groq_api_key                         | Groq LLM (primary for every tier)
# replicate_api_token                  | Replicate (LLM fallback + video generation)
# huggingface_api_token                | HuggingFace image editing fallback
# cloudflare_account_id                | Cloudflare Workers AI image editing (primary)
# cloudflare_api_token                 | Cloudflare Workers AI image editing (primary)
# falai_api_key                        | Fal.ai (currently unused/dead code, kept for parity)
# firecrawl_api_key                    | Product/Brand crawler's Firecrawl fallback (optional —
#                                       | the crawler still works via Playwright alone without it)
# cloudinary_url                       | Cloudinary asset storage — format:
#                                       | cloudinary://<api_key>:<api_secret>@<cloud_name>
# langsmith_api_key                    | LangSmith tracing
# compliance_qa_enabled                | true/false
# multi_generation_parallel_enabled    | true/false
# stream_llm_thinking_enabled          | true/false
# canvas_versioning_enabled            | true/false
#
# Insert via Supabase's SQL editor, e.g.:
#   insert into app_settings (key, value, created_at, updated_at) values
#     ('groq_api_key', 'your-key-here', now(), now())
#   on conflict (key) do update set value = excluded.value, updated_at = now();
