# Only backend/ and frontend/ source (plus the Docker Compose setup) are tracked in this repo.
/*
!/backend
!/frontend
!/.gitignore
!/docker-compose.yml
!/DOCKER.md
!/.env.example
!/.github

# --- Backend excludes ---
backend/venv/
backend/.env
backend/poc.db
backend/var/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/**/*.egg-info/
backend/.pytest_cache/
backend/**/.pytest_cache/

# Runtime-downloaded font cache (text_overlay.py's `_ensure_font_file`) — fetched on first use,
# never source; committing the binaries would just bloat the repo for no benefit.
backend/src/services/tools/fonts/

# --- Frontend excludes ---
frontend/node_modules/
frontend/.env.local
frontend/.next/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# --- OS cruft ---
.DS_Store
**/.DS_Store
